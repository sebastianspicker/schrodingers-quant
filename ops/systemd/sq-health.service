[Unit]
Description=Schrödingers Quant health check (dead-man's-switch ping)
Documentation=file:///opt/schrodingers-quant/ops/README.md
After=schrodingers-quant.service
OnFailure=sq-alert@%n.service

[Service]
Type=oneshot
User=sq
WorkingDirectory=/opt/schrodingers-quant
EnvironmentFile=/etc/schrodingers-quant/ops.env
ExecStart=/usr/bin/python3 /opt/schrodingers-quant/ops/health_ping.py
TimeoutStartSec=60

# Cheap hardening; unverified by systemd-analyze on this macOS development
# machine — see ops/README.md §4.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
